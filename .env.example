# Database
DATABASE_URL="postgresql://user:password@localhost:5432/kaizen_multi_tenant"

# JWT
JWT_SECRET="your-super-secret-key-change-in-production"
# Login JWT expiration is resolved server-side from SESSION_TIMEOUT_MINUTES.
# Rollout (dev/test first): run `npm run db:migrate --workspace=apps/api` with an isolated DATABASE_URL before enabling auth.
# No automatic production migration. Legacy JWTs without sessionToken are rejected; users must log in again.
SESSION_TIMEOUT_MINUTES="30"

# App
NODE_ENV="development"
API_PORT=3001
WEB_PORT=3000
