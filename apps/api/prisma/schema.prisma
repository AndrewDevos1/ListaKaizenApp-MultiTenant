// FASE 5 — Notificações, Convites, Auditoria
// ============================================================

enum StatusEntregaEpi {
  PENDENTE
  ACEITO
  RECUSADO
  CANCELADO
}

enum StatusFisicoEntregaEpi {
  PREPARADA
  ENTREGUE
  NAO_ENTREGUE
}

enum StatusAceiteEntregaEpi {
  PENDENTE
  ACEITO
  RECUSADO
}

enum TipoEventoEntregaEpi {
  CRIADA
  ENTREGA_FISICA_CONFIRMADA
  ACEITE_ELETRONICO
  RECUSA
  CANCELADA
  DIVERGENCIA
}

enum TipoNotificacao {
  SUBMISSAO_PENDENTE
  SUBMISSAO_APROVADA
  SUBMISSAO_REJEITADA
  RECEBIMENTO_CONFIRMADO
  LISTA_RAPIDA_PENDENTE
  LISTA_RAPIDA_APROVADA
  LISTA_RAPIDA_REJEITADA
  SUGESTAO_APROVADA
  SUGESTAO_REJEITADA
  CLASSIFICACAO_FALTA
  ENTREGA_EPI
}

model Notificacao {
  id            Int              @id @default(autoincrement())
  usuarioId     Int              @map("usuario_id")
  restauranteId Int              @map("restaurante_id")
  tipo          TipoNotificacao
  mensagem      String
  lida          Boolean          @default(false)
  criadoEm      DateTime         @default(now()) @map("criado_em")

  usuario     Usuario     @relation(fields: [usuarioId], references: [id])
  restaurante Restaurante @relation(fields: [restauranteId], references: [id])
  referenciaId Int? @map("referencia_id")
  deepLink String? @map("deep_link")

  @@map("notificacoes")
}

model ConviteToken {
  id            Int      @id @default(autoincrement())
  token         String   @unique
  email         String?
  restauranteId Int?     @map("restaurante_id")
  role          UserRole @default(COLLABORATOR)
  usado         Boolean  @default(false)
  expiresAt     DateTime @map("expires_at")
  criadoEm      DateTime @default(now()) @map("criado_em")

  restaurante Restaurante? @relation(fields: [restauranteId], references: [id])

  @@map("convite_tokens")
}

model AppLog {
  id            Int      @id @default(autoincrement())
  restauranteId Int?     @map("restaurante_id")
  usuarioId     Int?     @map("usuario_id")
  acao          String
  entidade      String?
  entidadeId    Int?     @map("entidade_id")
  detalhes      Json?
  criadoEm      DateTime @default(now()) @map("criado_em")

  @@map("app_logs")
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  usuarioId Int      @map("usuario_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  criadoEm  DateTime @default(now()) @map("criado_em")

  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("push_subscriptions")
}

// --- Almoxarifado MVP (issue #37): estoque físico, independente de ListaItemRef ---
enum TipoMovimentacaoAlmoxarifado {
  ENTRADA
  SAIDA
  AJUSTE
}

// Estruturas #37 preservadas somente para compatibilidade histórica; a API #48 não as usa.
model AlmoxarifadoPosicaoLegada {
  id Int @id @default(autoincrement())
  restauranteId Int @map("restaurante_id")
  itemId Int @map("item_id")
  saldo Decimal @default(0) @db.Decimal(14, 3)
  minimo Decimal? @db.Decimal(14, 3)
  localizacao String?
  observacao String?
  ativo Boolean @default(true)
  criadoEm DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")
  restaurante Restaurante @relation(fields: [restauranteId], references: [id])
  item Item @relation(fields: [itemId], references: [id])
  movimentacoes AlmoxarifadoMovimentacaoLegada[]
  @@unique([restauranteId, itemId])
  @@map("almoxarifado_posicoes")
}
model AlmoxarifadoMovimentacaoLegada {
  id Int @id @default(autoincrement())
  restauranteId Int @map("restaurante_id")
  posicaoId Int @map("posicao_id")
  itemId Int @map("item_id")
  tipo TipoMovimentacaoAlmoxarifado
  quantidade Decimal @db.Decimal(14, 3)
  saldoAnterior Decimal @map("saldo_anterior") @db.Decimal(14, 3)
  saldoNovo Decimal @map("saldo_novo") @db.Decimal(14, 3)
  motivo String
  responsavelId Int @map("responsavel_id")
  responsavelNome String @map("responsavel_nome")
  chaveIdempotencia String @map("chave_idempotencia")
  criadoEm DateTime @default(now()) @map("criado_em")
  restaurante Restaurante @relation(fields: [restauranteId], references: [id])
  posicao AlmoxarifadoPosicaoLegada @relation(fields: [posicaoId], references: [id])
  item Item @relation(fields: [itemId], references: [id])
  @@unique([restauranteId, chaveIdempotencia])
  @@index([posicaoId, criadoEm])
  @@map("almoxarifado_movimentacoes")
}

enum CategoriaMaterialAlmoxarifado {
  UNIFORME
  CALCADO
  EPI
  FERRAMENTA
  OUTRO
}

// Domínio isolado de EPI/uniforme/ferramenta. Não referencia Item, Pedido ou listas de compra.
model MaterialAlmoxarifado {
  id              Int                          @id @default(autoincrement())
  restauranteId   Int                          @map("restaurante_id")
  nome            String
  categoria       CategoriaMaterialAlmoxarifado
  retornavel      Boolean
  valorReferencia Decimal                      @map("valor_referencia") @db.Decimal(14, 2)
  ativo           Boolean                      @default(true)
  criadoEm        DateTime                     @default(now()) @map("criado_em")
  atualizadoEm    DateTime                     @updatedAt @map("atualizado_em")
  restaurante     Restaurante                  @relation(fields: [restauranteId], references: [id])
  variantes       VarianteMaterialAlmoxarifado[]
  posicoes        PosicaoMaterialAlmoxarifado[]
  movimentacoes   MovimentoMaterialAlmoxarifado[]
  entregasEpiItens EntregaEpiItem[]
  custodiasEpi CustodiaEpiItem[]
  @@unique([restauranteId, nome])
  @@map("materiais_almoxarifado")
}

model VarianteMaterialAlmoxarifado {
  id          Int      @id @default(autoincrement())
  materialId  Int      @map("material_id")
  tamanho     String?
  descricao   String?
  criadoEm    DateTime @default(now()) @map("criado_em")
  material    MaterialAlmoxarifado @relation(fields: [materialId], references: [id], onDelete: Restrict)
  posicoes    PosicaoMaterialAlmoxarifado[]
  movimentacoes MovimentoMaterialAlmoxarifado[]
  entregasEpiItens EntregaEpiItem[]
  @@map("variantes_material_almoxarifado")
}

model PosicaoMaterialAlmoxarifado {
  id            Int      @id @default(autoincrement())
  restauranteId Int      @map("restaurante_id")
  materialId    Int      @map("material_id")
  varianteId    Int?     @map("variante_id")
  saldo         Decimal  @default(0) @db.Decimal(14, 3)
  minimo        Decimal? @db.Decimal(14, 3)
  localizacao   String?
  observacao    String?
  ativo         Boolean  @default(true)
  criadoEm      DateTime @default(now()) @map("criado_em")
  atualizadoEm  DateTime @updatedAt @map("atualizado_em")
  restaurante   Restaurante @relation(fields: [restauranteId], references: [id])
  material      MaterialAlmoxarifado @relation(fields: [materialId], references: [id])
  variante      VarianteMaterialAlmoxarifado? @relation(fields: [varianteId], references: [id])
  movimentacoes MovimentoMaterialAlmoxarifado[]
  entregasEpiItens EntregaEpiItem[]
  @@unique([restauranteId, materialId, varianteId])
  @@map("posicoes_material_almoxarifado")
}

model EntregaEpi {
  id Int @id @default(autoincrement())
  restauranteId Int @map("restaurante_id")
  funcionarioId Int @map("funcionario_id")
  criadoPorId Int @map("criado_por_id")
  status StatusEntregaEpi @default(PENDENTE) // compatibilidade: espelha o aceite/cancelamento legado
  statusFisico StatusFisicoEntregaEpi @default(PREPARADA) @map("status_fisico")
  statusAceite StatusAceiteEntregaEpi @default(PENDENTE) @map("status_aceite")
  entregueFisicamenteEm DateTime? @map("entregue_fisicamente_em")
  entreguePorId Int? @map("entregue_por_id")
  chaveEntregaFisica String? @map("chave_entrega_fisica")
  chaveIdempotencia String @map("chave_idempotencia")
  chaveUltimaTransicao String? @map("chave_ultima_transicao")
  hashCriacao String @map("hash_criacao")
  hashUltimaTransicao String? @map("hash_ultima_transicao")
  observacoes String?
  justificativaRecusa String? @map("justificativa_recusa")
  criadoEm DateTime @default(now()) @map("criado_em")
  aceitoEm DateTime? @map("aceito_em")
  recusadoEm DateTime? @map("recusado_em")
  canceladoEm DateTime? @map("cancelado_em")
  restaurante Restaurante @relation(fields: [restauranteId], references: [id])
  funcionario Usuario @relation("EntregaEpiFuncionario", fields: [funcionarioId], references: [id])
  criadoPor Usuario @relation("EntregaEpiCriador", fields: [criadoPorId], references: [id])
  entreguePor Usuario? @relation("EntregaEpiEntregador", fields: [entreguePorId], references: [id])
  itens EntregaEpiItem[]
  eventos EntregaEpiEvento[]
  custodias CustodiaEpiItem[]
  aceiteTermo AceiteTermoEpi?
  @@unique([restauranteId, chaveIdempotencia])
  @@unique([restauranteId, chaveEntregaFisica])
  @@map("entregas_epi")
}
model EntregaEpiItem {
  id Int @id @default(autoincrement())
  entregaId Int @map("entrega_id")
  posicaoId Int @map("posicao_id")
  materialId Int @map("material_id")
  varianteId Int? @map("variante_id")
  quantidade Decimal @db.Decimal(14,3)
  materialNomeSnapshot String @map("material_nome_snapshot")
  categoriaSnapshot CategoriaMaterialAlmoxarifado @map("categoria_snapshot")
  retornavelSnapshot Boolean @map("retornavel_snapshot")
  varianteSnapshot String? @map("variante_snapshot")
  entrega EntregaEpi @relation(fields: [entregaId], references: [id], onDelete: Cascade)
  posicao PosicaoMaterialAlmoxarifado @relation(fields: [posicaoId], references: [id], onDelete: Restrict)
  material MaterialAlmoxarifado @relation(fields: [materialId], references: [id], onDelete: Restrict)
  variante VarianteMaterialAlmoxarifado? @relation(fields: [varianteId], references: [id], onDelete: SetNull)
  custodia CustodiaEpiItem?
  @@map("entregas_epi_itens")
}

// Contrato mínimo consumido por #51: material comprovadamente entregue fica em posse do funcionário.
model CustodiaEpiItem {
  id Int @id @default(autoincrement())
  restauranteId Int @map("restaurante_id")
  entregaId Int @map("entrega_id")
  entregaItemId Int @unique @map("entrega_item_id")
  funcionarioId Int @map("funcionario_id")
  materialId Int @map("material_id")
  varianteId Int? @map("variante_id")
  quantidadeEmPosse Decimal @map("quantidade_em_posse") @db.Decimal(14, 3)
  retornavel Boolean
  iniciadaEm DateTime @map("iniciada_em")
  restaurante Restaurante @relation(fields: [restauranteId], references: [id], onDelete: Restrict)
  entrega EntregaEpi @relation(fields: [entregaId], references: [id], onDelete: Restrict)
  entregaItem EntregaEpiItem @relation(fields: [entregaItemId], references: [id], onDelete: Restrict)
  funcionario Usuario @relation("CustodiaEpiFuncionario", fields: [funcionarioId], references: [id], onDelete: Restrict)
  material MaterialAlmoxarifado @relation(fields: [materialId], references: [id], onDelete: Restrict)
  @@index([restauranteId, funcionarioId])
  @@map("custodias_epi_itens")
}

// Trilha append-only (trigger bloqueia UPDATE/DELETE).
model EntregaEpiEvento {
  id Int @id @default(autoincrement())
  restauranteId Int @map("restaurante_id")
  entregaId Int @map("entrega_id")
  tipo TipoEventoEntregaEpi
  atorId Int @map("ator_id")
  metadados Json?
  criadoEm DateTime @default(now()) @map("criado_em")
  restaurante Restaurante @relation(fields: [restauranteId], references: [id], onDelete: Restrict)
  entrega EntregaEpi @relation(fields: [entregaId], references: [id], onDelete: Restrict)
  ator Usuario @relation("EntregaEpiEventoAtor", fields: [atorId], references: [id], onDelete: Restrict)
  @@index([entregaId, criadoEm])
  @@map("entregas_epi_eventos")
}

model TermoResponsabilidade {
  id Int @id @default(autoincrement())
  restauranteId Int @map("restaurante_id")
  versao String
  texto String
  hashTermo String @map("hash_termo")
  criadoPorId Int @map("criado_por_id")
  criadoEm DateTime @default(now()) @map("criado_em")
  restaurante Restaurante @relation(fields: [restauranteId], references: [id], onDelete: Restrict)
  criadoPor Usuario @relation("TermoCriadoPor", fields: [criadoPorId], references: [id], onDelete: Restrict)
  aceites AceiteTermoEpi[]
  @@unique([restauranteId, versao])
  @@map("termos_responsabilidade")
}

model AceiteTermoEpi {
  id Int @id @default(autoincrement())
  restauranteId Int @map("restaurante_id")
  entregaId Int @unique @map("entrega_id")
  termoId Int @map("termo_id")
  funcionarioId Int @map("funcionario_id")
  snapshot Json
  hashSnapshot String @map("hash_snapshot")
  hashAssinatura String @map("hash_assinatura")
  hashDocumento String @map("hash_documento")
  hashPdf String @map("hash_pdf")
  storageKey String @map("storage_key")
  aceitoEm DateTime @default(now()) @map("aceito_em")
  restaurante Restaurante @relation(fields: [restauranteId], references: [id], onDelete: Restrict)
  entrega EntregaEpi @relation(fields: [entregaId], references: [id], onDelete: Restrict)
  termo TermoResponsabilidade @relation(fields: [termoId], references: [id], onDelete: Restrict)
  funcionario Usuario @relation(fields: [funcionarioId], references: [id], onDelete: Restrict)
  @@index([restauranteId, funcionarioId])
  @@map("aceites_termos_epi")
}

// Append-only. #49 consome somente material/variante/posição, nunca Item.
model MovimentoMaterialAlmoxarifado {
  id                Int                          @id @default(autoincrement())
  restauranteId     Int                          @map("restaurante_id")
  posicaoId         Int                          @map("posicao_id")
  materialId        Int                          @map("material_id")
  varianteId        Int?                         @map("variante_id")
  tipo              TipoMovimentacaoAlmoxarifado
  quantidade        Decimal                      @db.Decimal(14, 3)
  saldoAnterior     Decimal                      @map("saldo_anterior") @db.Decimal(14, 3)
  saldoNovo         Decimal                      @map("saldo_novo") @db.Decimal(14, 3)
  motivo            String
  responsavelId     Int                          @map("responsavel_id")
  responsavelNome   String                       @map("responsavel_nome")
  chaveIdempotencia String                       @map("chave_idempotencia")
  criadoEm          DateTime                     @default(now()) @map("criado_em")
  restaurante Restaurante                  @relation(fields: [restauranteId], references: [id])
  posicao     PosicaoMaterialAlmoxarifado  @relation(fields: [posicaoId], references: [id])
  material    MaterialAlmoxarifado         @relation(fields: [materialId], references: [id])
  variante    VarianteMaterialAlmoxarifado? @relation(fields: [varianteId], references: [id])
  @@unique([restauranteId, chaveIdempotencia])
  @@index([posicaoId, criadoEm])
  @@map("movimentos_material_almoxarifado")
}
